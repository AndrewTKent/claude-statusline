#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -n "${AGENT_METRICS_PYTHON:-}" ]; then
    candidates=("$AGENT_METRICS_PYTHON")
else
    candidates=(python3 python3.14 python3.13 python3.12 python3.11)
fi

for candidate in "${candidates[@]}"; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import tomllib' >/dev/null 2>&1; then
        exec "$candidate" "$script_dir/agent_metrics.py" "$@"
    fi
done

echo "Agent Metrics requires Python 3.11 or newer." >&2
exit 1
