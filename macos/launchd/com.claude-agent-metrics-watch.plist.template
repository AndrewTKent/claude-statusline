<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the Agent Metrics recorder launchd agent.

  install-agent-metrics.sh populates REPO_ROOT and HOME, copies this file to
  ~/Library/LaunchAgents/ and loads it.

  The recorder is `agent-metrics watch`: a foreground loop that folds new
  Claude Code and Codex JSONL lines into the metrics database. With
  AGENT_METRICS_RECORDER=1 the statusline reads its "today" figure from that
  database, so the loop has to outlive any one terminal. launchd restarts it
  on crash with a 10s throttle.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude-agent-metrics-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/bin/agent-metrics</string>
        <string>watch</string>
        <string>--interval</string>
        <string>60</string>
        <string>--max-lines</string>
        <string>5000</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/agent-metrics-watch-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/agent-metrics-watch-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
