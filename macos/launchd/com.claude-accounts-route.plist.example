<?xml version="1.0" encoding="UTF-8"?>
<!-- accounts route: the account-routing daemon. Every interval it polls each stored
     account's remaining limits and, in AUTO, overwrites ~/.claude/.credentials.json
     with the freshest account when the live one runs low (in SET, holds the pin).
     File-only — it never writes the keychain (see bin/accounts.py).

     Install:
       1. Edit the two paths below to match your checkout and username.
       2. Copy to ~/Library/LaunchAgents/com.claude-accounts-route.plist
       3. launchctl load ~/Library/LaunchAgents/com.claude-accounts-route.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude-accounts-route</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Edit path to point at your checkout. -->
        <string>exec /opt/homebrew/bin/python3 "/PATH/TO/claude-statusline/bin/accounts.py" route --interval 30</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/claude-accounts-route.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/claude-accounts-route.stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Edit HOME to your username. -->
        <key>HOME</key>
        <string>/Users/YOURUSER</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
