<?xml version="1.0" encoding="UTF-8"?>
<!-- Watches ~/.claude/projects/ for JSONL changes and re-runs scan-tokens.py
     within ~1s. Keeps the statusline's cache fresh without depending on
     Claude Code re-invoking the statusline script.

     Install:
       1. Edit the paths below to match your checkout location.
       2. Copy to ~/Library/LaunchAgents/com.claude-scan-tokens-watch.plist
       3. launchctl load ~/Library/LaunchAgents/com.claude-scan-tokens-watch.plist

     Requires: fswatch (brew install fswatch).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude-scan-tokens-watch</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Edit this path to point at your checkout of claude-statusline/bin/ -->
        <string>/PATH/TO/claude-statusline/bin/scan-tokens-watch.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Don't respawn faster than once every 10s if the watcher crashes. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/claude-scan-tokens-watch.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/claude-scan-tokens-watch.stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Edit HOME to your username. -->
        <key>HOME</key>
        <string>/Users/YOURUSER</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
