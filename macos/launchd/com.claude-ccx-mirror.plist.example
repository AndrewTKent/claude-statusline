<?xml version="1.0" encoding="UTF-8"?>
<!-- ccx mirror: keeps the per-account credential vault in sync with the live
     "Claude Code-credentials" keychain slot, so /login and token refreshes
     never lose an account (see bin/ccx.py).

     Install:
       1. Edit the paths below to match your checkout location.
       2. Copy to ~/Library/LaunchAgents/com.claude-ccx-mirror.plist
       3. launchctl load ~/Library/LaunchAgents/com.claude-ccx-mirror.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude-ccx-mirror</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- Edit path to point at your checkout. -->
        <string>exec /opt/homebrew/bin/python3 "/PATH/TO/claude-statusline/bin/ccx.py" mirror --interval 20</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/claude-ccx-mirror.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/claude-ccx-mirror.stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Edit HOME to your username. -->
        <key>HOME</key>
        <string>/Users/YOURUSER</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
